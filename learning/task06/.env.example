# 模型配置：沿用 task02-task05 的 SiliconFlow OpenAI-compatible 方式
MODEL_NAME=zai-org/GLM-5.2
SILICONFLOW_API_KEY=your-siliconflow-key
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# langgraph dev 本地服务需要 LangSmith 鉴权。
# 若使用 LangGraph/LangSmith 托管服务，也可使用 LANGGRAPH_API_KEY。
LANGSMITH_API_KEY=your-langsmith-key

# 可选：便于在 LangSmith 中区分本章实验
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=deepagents-task06-async-subagents

